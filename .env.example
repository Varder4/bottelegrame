# Sao chép thành .env rồi điền giá trị thật. KHÔNG BAO GIỜ commit .env.
# Ứng dụng fail-fast lúc khởi động nếu thiếu bất kỳ biến bắt buộc nào.

# ── Telegram ────────────────────────────────────────────────────────
TELEVIP_BOT_TOKEN=123456789:AA...thay-bang-token-that
TELEVIP_ADMIN_GROUP_ID=-1000000000000
TELEVIP_ANNOUNCE_CHANNEL_ID=-1000000000000

# Webhook (để trống ở dev → dùng polling)
TELEVIP_WEBHOOK_BASE_URL=
TELEVIP_WEBHOOK_SECRET_PATH=
TELEVIP_WEBHOOK_SECRET_TOKEN=

# ── Cơ sở dữ liệu ───────────────────────────────────────────────────
TELEVIP_DATABASE_URL=postgresql+asyncpg://televip:televip_dev_only@127.0.0.1:5433/televip
TELEVIP_DB_POOL_SIZE=10

# ── Redis ───────────────────────────────────────────────────────────
TELEVIP_REDIS_URL=redis://127.0.0.1:6380/0

# ── Môi trường ──────────────────────────────────────────────────────
# dev | staging | production. Ở production, INITDATA_MODE=off bị TỪ CHỐI khởi động.
TELEVIP_ENV=dev
TELEVIP_LOG_LEVEL=INFO

# ── Bảo mật Mini App ────────────────────────────────────────────────
# shadow = kiểm chữ ký nhưng chỉ ghi log, on = từ chối request sai chữ ký.
# off chỉ dùng khi chạy test cục bộ, KHÔNG được dùng ở production.
TELEVIP_INITDATA_MODE=on
TELEVIP_INITDATA_TTL_SECONDS=300

# ── GeoIP (tuỳ chọn ở dev) ──────────────────────────────────────────
TELEVIP_GEOIP_ASN_DB=
TELEVIP_GEOIP_COUNTRY_DB=
