[Unit]
Description=HK79 - panel quan tri web
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=televip
Group=televip
WorkingDirectory=/opt/televip
EnvironmentFile=/opt/televip/.env

ExecStart=/opt/televip/.venv/bin/uvicorn televip.apps.adminweb.app:create_app \
    --factory --host 127.0.0.1 --port 8100 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=televip-panel

[Install]
WantedBy=multi-user.target
